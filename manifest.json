{
  "manifest_version": 3,
  "name": "Default Browser Links",
  "version": "1.1.0",
  "description": "Opens links from installed web apps (PWAs), or from every window, in your computer's default browser.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Default Browser Links",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "webNavigation",
    "contextMenus",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["rules.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "commands": {
    "open-page": {
      "suggested_key": { "default": "Alt+Shift+E", "mac": "Alt+Shift+E" },
      "description": "Open the current page in the default browser"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  }
}
